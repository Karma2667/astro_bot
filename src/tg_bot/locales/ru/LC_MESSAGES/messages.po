msgid "max_profiles_msg"
msgstr "<b>❌ Вы уже создали максимальное количество профилей (3) на один аккаунт!</b>\nВы можете удалить один из существующих профилей перед созданием нового."

msgid "send_prof_name_msg"
msgstr "✨ <b>Отправьте имя</b>\nНапример: <i>Инокентий Аркадьевич</i>"

msgid "prof_name_err_msg"
msgstr "⚠️ <b>Ошибка!</b>\nПопробуйте ввести имя еще раз!"

msgid "send_birth_date_msg"
msgstr "🎉🎂 <b>Отправьте дату рождения</b>\nНапример: <i>20.12.2004</i>"

msgid "birth_date_err_msg"
msgstr "⚠️ <b>Ошибка!</b>\nПопробуйте ввести дату рождения еще раз, в правильном формате."

msgid "send_birth_time_msg"
msgstr "🕒 <b>Отправьте время рождения</b>\nНапример: <i>00:23</i>. По умолчанию: <i>00:00</i>"

msgid "birth_time_err_msg"
msgstr "⚠️ <b>Ошибка!</b>\nПожалуйста, введите время рождения снова, убедитесь, что оно корректное."

msgid "send_birth_location_msg"
msgstr "📍 <b>Отправьте название места вашего рождения. Например: Россия, г. Москва</b>"

msgid "birth_location_err_msg"
msgstr "⚠️ <b>Ошибка!</b>\nПожалуйста, отправьте название места вашего рождения, чтобы мы могли правильно рассчитать ваш гороскоп."

msgid "send_current_location_msg"
msgstr "🌍 <b>Пожалуйста, отправьте геолокацию вашего текущего расположения</b>"

msgid "current_location_err_msg"
msgstr "⚠️ <b>Ошибка!</b>\nПожалуйста, отправьте геолокацию вашего текущего расположения, чтобы мы могли обновить информацию."

msgid "new_profile_msg"
msgstr "🎉 <b>Новый профиль успешно создан!</b>\nВоспользуйтесь командой <i>/profile</i>"

