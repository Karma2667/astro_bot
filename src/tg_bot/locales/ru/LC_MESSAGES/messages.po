# Base messages and Keyboard's buttons
msgid "start_msg"
msgstr "<b>Добро пожаловать в мир астрологии!</b> ✨\nЭтот бот поможет вам рассчитать гороскоп и узнать важные даты и события, которые произойдут в вашей жизни. Просто укажите дату, время и место рождения, и мы произведем астрологический расчет для вас!\n<b>Пусть звезды ведут вас!</b> 🌟"

msgid "help_msg"
msgstr "<b>📋 Вот список доступных команд:</b>\n<i>/help</i> - посмотреть доступные команды\n<i>/lang</i> - поменять язык\n<i>/profile</i> - редактировать данные профиля\n<i>/horoscope</i> - рассчитать энергию дня или месяца\n<i>/events</i> - рассчитать события и их даты\n<i>/sub</i> - изменить статус аккаунта\n<i>/menu</i> - вернуться в главное меню\n<i>/admin</i> - получить ссылку админ-панели"

msgid "lang_msg"
msgstr "<b>Выберите язык 🌐</b>\nВыберите язык общения с ботом для дальнейшей работы."

msgid "russian_btn"
msgstr "Россия 🇷🇺"

msgid "english_btn"
msgstr "English 🇬🇧"

msgid "lang_changed_msg"
msgstr "<b>Язык изменен на русский! 🇷🇺</b>"

msgid "not_admin_msg"
msgstr "<b>Вы не являетесь администратором!</b>"

msgid "admin_panel_msg"
msgstr "Панель админа 💻"

